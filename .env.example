# ============================================================================
# MYDIGITASSET ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
# ============================================================================
# Copy this file to .env and populate the required secrets for your environment.
# Never commit real API keys, tokens, or credentials into version control.

# ============================================================================
# 1. REQUIRED PRODUCTION VARIABLES (Mandatory for live operations)
# ============================================================================

# Google OAuth 2.0 Admin Authentication
# Single authorized administrator email address (whitelisted in auth engine)
ADMIN_EMAIL=mihirkapuria@gmail.com
ADMIN_RECOVERY_EMAIL=mihirkapuria@gmail.com

# Google OAuth 2.0 Web Client credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Bot API Configuration (from @BotFather)
# Required for private 1-to-1 daily executive briefings and Day-3 trial reminders
TELEGRAM_BOT_TOKEN=

# Telegram Bot Public Username (e.g. MyDigitAssetNewsBot) used for deep-link generation
TELEGRAM_BOT_USERNAME=MyDigitAssetNewsBot

# Secret token configured in Telegram webhook header (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=


# ============================================================================
# 2. OPTIONAL VARIABLES
# ============================================================================

# Gemini AI API Key: Required for live LLM news synthesis.
# If omitted or unavailable, news engine falls back gracefully to grounded candidate pool.
GEMINI_API_KEY=

# Public Application URL: The HTTPS URL where this applet is hosted (e.g. Cloud Run URL or custom domain)
APP_URL=https://www.mydigitasset.com

# Stage 3A Option 2: Apps Script Machine-to-Machine Scheduler Configuration
# High-entropy random secret (>= 256 bits) for Apps Script -> Cloud Run scheduled triggers
# Sent ONLY in HTTP request header: X-Scheduler-Token. Must match Script Properties.
APPS_SCRIPT_SCHEDULER_SECRET=

# Cloud Run Service URL used by Apps Script and as expected audience in Google OIDC ID tokens
CLOUD_RUN_SERVICE_URL=https://ais-dev-yhopij5yks7yremfckkcgh-532434283453.asia-southeast1.run.app

# Dedicated Cloud Scheduler Service Account Email (Optional fallback if Google Cloud Scheduler is enabled)
SCHEDULER_SERVICE_ACCOUNT_EMAIL=mydigitasset-scheduler@knitted-temple-nmjvc.iam.gserviceaccount.com


# Stage 3C: Google Sheet Synchronization (Firestore -> Google Sheet Mirror)
# Web App deployment URL of the Google Apps Script attached to spreadsheet 1VxEwbU0TupxdqNIhslFDL-hcZLpY0QBPcqVt-h8O43A
APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/.../exec

# High-entropy random secret for machine-to-machine sync authentication.
# Must match SHEET_SYNC_SECRET configured in Apps Script Script Properties.
# Sent ONLY in HTTP request header: X-Sync-Token
SHEET_SYNC_SECRET=

# Server Port (defaults to 3000 if omitted)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production


# ============================================================================
# 3. CURRENTLY UNUSED / DEFERRED VARIABLES (Razorpay Automated Gateway)
# ============================================================================
# NOTE: The current production MVP exclusively uses MANUAL UPI PAYMENT +
# CUSTOMER UTR SUBMISSION + ADMIN VERIFICATION.
# The Razorpay variables below are reserved for future phases and are NOT active
# for standard customer subscription activation in this MVP.

# PAYMENT_PROVIDER_MODE: 'test' for Sandbox or 'live' for Production
PAYMENT_PROVIDER_MODE=test

# Razorpay Test Credentials:
RAZORPAY_TEST_KEY_ID=rzp_test_...
RAZORPAY_TEST_KEY_SECRET=...
RAZORPAY_TEST_WEBHOOK_SECRET=...

# Razorpay Live Credentials:
RAZORPAY_LIVE_KEY_ID=rzp_live_...
RAZORPAY_LIVE_KEY_SECRET=...
RAZORPAY_LIVE_WEBHOOK_SECRET=...
